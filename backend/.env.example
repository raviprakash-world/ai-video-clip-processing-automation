# Copy this file to backend/.env and fill in real values. .env is gitignored --
# never commit real credentials. See README.md "Setting it up for real" for how
# to obtain each of these.

# --- Token encryption (required for tokens to survive a server restart) -----
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- YouTube (Google Cloud Console -> APIs & Services -> Credentials) ------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Only change this if you're not running on localhost:8077.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8077/api/publishing/youtube/callback

# --- Facebook + Instagram (developers.facebook.com -> your App) -----------
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:8077/api/publishing/meta/callback
# Required: create this under the app's "Facebook Login for Business" product
# -> Configurations -> + Create configuration (User access token type). Meta's
# current app-creation flow no longer accepts a plain scope list for
# pages_manage_posts / instagram_content_publish -- see README.md.
META_LOGIN_CONFIG_ID=

# Instagram's Content Publishing API requires Meta's servers to fetch the
# video from a real public HTTPS URL -- leave empty to keep Instagram
# reported as NOT_AVAILABLE (Facebook Page publishing doesn't need this).
PUBLIC_BASE_URL=

# --- Optional tuning (defaults shown) ---------------------------------------
# PUBLISH_INTERVAL_MINUTES=60
# BLOCK_WARNINGS=true
